<Window x:Class="LuckyStrikeCleanUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuckyStrikeCleanUp"
        mc:Ignorable="d"
        Title="LuckyStrike Windows CleanUP v3.0" 
        Icon="app.ico"
        Height="780" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <local:StatusToBadgeBgConverter x:Key="StatusBadgeBgConv"/>
        <local:StatusToIconConverter x:Key="StatusIconConv"/>

        <!-- Modern Button Style -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool Button Style -->
        <Style x:Key="ToolBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#25283D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#353952"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#313652"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#202334"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Main Window Border with DropShadow and Rounded Corners -->
    <Border Background="#0F111A" CornerRadius="12" BorderBrush="#26293D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Top Action Header -->
                <RowDefinition Height="*"/>    <!-- Main Body: Modules & Console -->
                <RowDefinition Height="38"/>   <!-- Footer / Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM TITLE BAR -->
            <Border Grid.Row="0" Background="#141724" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown" BorderBrush="#202336" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="app.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="LuckyStrike-Windows-CleanUP" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="v3.0 Pro" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Admin Status Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border x:Name="AdminBadgeBorder" CornerRadius="6" Padding="10,4" Background="#1E3A2F" BorderBrush="#00E676" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtAdminIcon" Text="🛡️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAdminStatus" Text="Yönetici Modu Aktif" Foreground="#00E676" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnRelaunchAdmin" Click="BtnRelaunchAdmin_Click" Visibility="Collapsed" Style="{StaticResource ToolBtnStyle}" Margin="10,0,0,0" Content="Yönetici Olarak Yeniden Başlat" Background="#E65100" Foreground="White" BorderBrush="#FF6D00"/>
                    </StackPanel>

                    <!-- Window Control Buttons (Min, Close) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnMinimize_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Foreground="#9AA0B4" FontSize="15" Content="—" Cursor="Hand"/>
                        <Button Click="BtnClose_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Foreground="#FF5252" FontSize="16" FontWeight="Bold" Content="✕" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. TOP ACTION HEADER & CONTROLS -->
            <Border Grid.Row="1" Background="#161825" Padding="20,14" BorderBrush="#202336" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Quick Description & Disk Badge -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sistem Bakımı" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <Border x:Name="FreedDiskBadge" Visibility="Collapsed" Background="#1E3A2F" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock x:Name="TxtFreedDisk" Text="Kazanılan Alan: 0 MB" Foreground="#00E676" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tek tıkla derin temizlik ve sistem hızlandırma." Foreground="#8A92A6" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Start Cleanup Button -->
                        <Button x:Name="BtnStartCleanup" Click="BtnStartCleanup_Click" Style="{StaticResource ActionBtnStyle}" Background="#00B4D8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Temizliği Başlat" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop Cleanup Button (Initially Collapsed) -->
                        <Button x:Name="BtnStopCleanup" Click="BtnStopCleanup_Click" Visibility="Collapsed" Style="{StaticResource ActionBtnStyle}" Background="#E53935" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏹" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Durdur" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Create Restore Point Button -->
                        <Button x:Name="BtnRestorePoint" Click="BtnRestorePoint_Click" Style="{StaticResource ToolBtnStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Geri Yükleme Noktası" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Winget Upgrade Button -->
                        <Button x:Name="BtnWinget" Click="BtnWinget_Click" Style="{StaticResource ActionBtnStyle}" Background="#E5A93C" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Uygulamaları Güncelle" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Restart PC Button -->
                        <Button Click="BtnRestartPC_Click" Style="{StaticResource ToolBtnStyle}" Margin="0,0,6,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Yeniden Başlat" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Shutdown PC Button -->
                        <Button Click="BtnShutdownPC_Click" Style="{StaticResource ToolBtnStyle}" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Kapat" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. MAIN BODY -->
            <Grid Grid.Row="2" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>  <!-- Left: Clean Modules (18 Steps) -->
                    <ColumnDefinition Width="14"/>     <!-- Splitter Space -->
                    <ColumnDefinition Width="1*"/>    <!-- Right: Progress & Live Console -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: MODULES LIST -->
                <Border Grid.Column="0" Background="#161825" CornerRadius="10" BorderBrush="#25283D" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Selection Tools -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Module List -->
                        </Grid.RowDefinitions>

                        <!-- Module List Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Temizlik Modülleri" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="(18 Adım)" Foreground="#00D2FF" FontSize="13" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnSelectAll_Click" Style="{StaticResource ToolBtnStyle}" Content="Tümünü Seç" Margin="0,0,5,0"/>
                                <Button Click="BtnDeselectAll_Click" Style="{StaticResource ToolBtnStyle}" Content="Seçimi Kaldır" Margin="0,0,5,0"/>
                                <Button Click="BtnSelectDefault_Click" Style="{StaticResource ToolBtnStyle}" Content="Varsayılan"/>
                            </StackPanel>
                        </Grid>

                        <!-- Scrollable Modules -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="StepsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Background="#1D2030" CornerRadius="8" Padding="10,7" BorderBrush="#282C44" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                    <ColumnDefinition Width="*"/>    <!-- Title & Desc -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Status Badge -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Step Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Step Title and Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="[" Foreground="#00D2FF" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Id}" Foreground="#00D2FF" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="] " Foreground="#00D2FF" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="#848B9E" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6" Padding="8,4" 
                                                        Background="{Binding Status, Converter={StaticResource StatusBadgeBgConv}}"
                                                        BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource StatusBrushConv}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusIconConv}}" 
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" 
                                                                   FontWeight="Bold" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusText}" 
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" 
                                                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: PROGRESS & LIVE CONSOLE -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Progress Card -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>    <!-- Live Console Card -->
                    </Grid.RowDefinitions>

                    <!-- PROGRESS CARD -->
                    <Border Grid.Row="0" Background="#161825" CornerRadius="10" BorderBrush="#25283D" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="İlerleme Durumu" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="#00D2FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Modern Progress Bar -->
                            <ProgressBar x:Name="MainProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#23263B" Foreground="#00D2FF" BorderThickness="0"/>

                            <TextBlock x:Name="TxtCurrentStep" Text="Temizlik başlatılmaya hazır." Foreground="#9AA0B4" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- LIVE CONSOLE CARD -->
                    <Border Grid.Row="2" Background="#161825" CornerRadius="10" BorderBrush="#25283D" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Console Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Console Output -->
                            </Grid.RowDefinitions>

                            <!-- Console Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Canlı İşlem Konsolu" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <Border Background="#1E3A2F" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="CANLI" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="BtnOpenLogFolder_Click" Style="{StaticResource ToolBtnStyle}" Content="📁 Log Dosyası" Margin="0,0,5,0"/>
                                    <Button Click="BtnCopyLogs_Click" Style="{StaticResource ToolBtnStyle}" Content="📋 Kopyala" Margin="0,0,5,0"/>
                                    <Button Click="BtnClearConsole_Click" Style="{StaticResource ToolBtnStyle}" Content="🧹 Temizle"/>
                                </StackPanel>
                            </Grid>

                            <!-- Terminal Console Box -->
                            <Border Grid.Row="1" Background="#0A0C14" CornerRadius="8" BorderBrush="#1F2336" BorderThickness="1" Padding="10">
                                <TextBox x:Name="TxtConsole" 
                                         Background="Transparent" 
                                         Foreground="#38EF7D" 
                                         FontFamily="Consolas, Courier New, monospace" 
                                         FontSize="12" 
                                         IsReadOnly="True" 
                                         TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         SelectionBrush="#00D2FF"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. FOOTER / STATUS BAR -->
            <Border Grid.Row="3" Background="#11131E" CornerRadius="0,0,12,12" BorderBrush="#202336" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#00E676" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatusSummary" Text="Hazır - Temizlenecek adımları seçin ve 'Temizliği Başlat' butonuna basın." Foreground="#8A92A6" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="LuckyStrike-Windows-CleanUP v3.0 Pro | Windows 10 &amp; 11" Foreground="#5E657B" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
